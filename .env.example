# Database
DATABASE_URL=postgresql+psycopg://naseembeauty:naseembeauty@naseembeauty_database:5432/naseembeauty

# Run Alembic migrations on startup
RUN_MIGRATIONS_ON_START=true

# Google Sheets webhook — same Sukoon spreadsheet, tab «نسيم»
# After updating sheets/sokon-apps-script.js: run createNassimOrderTab + New version Deploy
SHEET_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbxTidbmqTr6dKV7lOEmlQBR81R_Sv-VF8AA7UerWzvJ0wWd8pT5QtyyA9NlOGU7WLE9YQ/exec

# Meta — add these on EasyPanel backend (same IDs as Events Manager)
META_PIXEL_ID=your_pixel_id
META_ACCESS_TOKEN=your_access_token

# TikTok Events API
TIKTOK_PIXEL_ID=your_pixel_id
TIKTOK_ACCESS_TOKEN=your_access_token

# Snap CAPI
SNAP_PIXEL_ID=your_pixel_id
SNAP_ACCESS_TOKEN=your_access_token

# MaxMind GeoIP2 Insights (IP fraud / VPN / country detection)
# Sign up at https://www.maxmind.com/en/geoip2-precision-insights
MAXMIND_ACCOUNT_ID=your_account_id
MAXMIND_LICENSE_KEY=your_license_key

# Frontend URL for CORS
FRONTEND_URL=https://naseem.beauty

# Admin key for /admin/aov (Profit Calculator)
ADMIN_API_KEY=change-me

# Environment: development | production
ENVIRONMENT=production

# Set true later to lock checkout to Saudi phones + MaxMind geo.
RESTRICT_ORDERS_TO_SAUDI=false

# Cloudflare: api.naseem.beauty currently 301/308 to the SAME https URL (Failed to fetch).
# Fix in Cloudflare: SSL/TLS mode Full (not Flexible), and remove Page Rules that redirect
# https://api.naseem.beauty/* onto itself. Origin must not HTTP→HTTPS redirect behind Flexible.
