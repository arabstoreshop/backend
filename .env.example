# Database
DATABASE_URL=postgresql+psycopg://naseembeauty:naseembeauty@naseembeauty_database:5432/naseembeauty

# Run Alembic migrations on startup
RUN_MIGRATIONS_ON_START=true

# Google Sheets webhook (Apps Script URL)
SHEET_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Meta CAPI
META_PIXEL_ID=your_pixel_id
META_ACCESS_TOKEN=your_access_token

# TikTok Events API
TIKTOK_PIXEL_ID=your_pixel_id
TIKTOK_ACCESS_TOKEN=your_access_token

# Snap CAPI
SNAP_PIXEL_ID=your_pixel_id
SNAP_ACCESS_TOKEN=your_access_token

# MaxMind GeoIP2 Insights (IP fraud / VPN / country detection)
# Sign up at https://www.maxmind.com/en/geoip2-precision-insights
MAXMIND_ACCOUNT_ID=your_account_id
MAXMIND_LICENSE_KEY=your_license_key

# Frontend URL for CORS
FRONTEND_URL=https://naseem.beauty

# Environment: development | production
ENVIRONMENT=production
